{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Omni-graph storage preparation, integration API 1",
  "type": "object",
  "required": [
    "integration_api_version",
    "ready",
    "exit_code",
    "stores",
    "compatibility",
    "skipped_registrations"
  ],
  "properties": {
    "integration_api_version": {
      "const": 1
    },
    "ready": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "compatibility": {
      "type": "object",
      "required": [
        "executable",
        "integration_api_version",
        "supported_api_versions",
        "database",
        "capabilities",
        "stores",
        "status",
        "exit_code"
      ],
      "properties": {
        "executable": {
          "type": "object",
          "required": [
            "version",
            "path"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "integration_api_version": {
          "const": 1
        },
        "supported_api_versions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "database": {
          "type": "object",
          "required": [
            "read_versions",
            "write_versions",
            "migratable_versions",
            "migration_target",
            "migration_policy"
          ],
          "properties": {
            "read_versions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "write_versions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "migratable_versions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "migration_target": {
              "type": "integer"
            },
            "migration_policy": {
              "const": "automatic_on_open_with_backup"
            }
          },
          "additionalProperties": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "detected_schema_version",
              "status",
              "migration_required",
              "migration_supported",
              "recovery"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "detected_schema_version": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "compatible",
                  "missing_store",
                  "migration_required",
                  "unsupported_schema",
                  "permission_denied",
                  "invalid_database",
                  "unrecognized_database",
                  "busy",
                  "io_error",
                  "legacy_migration_required"
                ]
              },
              "migration_required": {
                "type": "boolean"
              },
              "migration_supported": {
                "type": "boolean"
              },
              "recovery": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "status": {
          "enum": [
            "compatible",
            "missing_store",
            "migration_required",
            "unsupported_schema",
            "permission_denied",
            "invalid_database",
            "unrecognized_database",
            "busy",
            "io_error",
            "legacy_migration_required"
          ]
        },
        "exit_code": {
          "enum": [
            0,
            10,
            11,
            12,
            13,
            14,
            15,
            16
          ]
        }
      },
      "additionalProperties": true,
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Omni-graph compatibility response, integration API 1"
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "before",
          "after",
          "action",
          "error"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "before": {
            "type": "object",
            "required": [
              "path",
              "detected_schema_version",
              "status",
              "migration_required",
              "migration_supported",
              "recovery"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "detected_schema_version": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "compatible",
                  "missing_store",
                  "migration_required",
                  "unsupported_schema",
                  "permission_denied",
                  "invalid_database",
                  "unrecognized_database",
                  "busy",
                  "io_error",
                  "legacy_migration_required"
                ]
              },
              "migration_required": {
                "type": "boolean"
              },
              "migration_supported": {
                "type": "boolean"
              },
              "recovery": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "after": {
            "type": "object",
            "required": [
              "path",
              "detected_schema_version",
              "status",
              "migration_required",
              "migration_supported",
              "recovery"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "detected_schema_version": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "compatible",
                  "missing_store",
                  "migration_required",
                  "unsupported_schema",
                  "permission_denied",
                  "invalid_database",
                  "unrecognized_database",
                  "busy",
                  "io_error",
                  "legacy_migration_required"
                ]
              },
              "migration_required": {
                "type": "boolean"
              },
              "migration_supported": {
                "type": "boolean"
              },
              "recovery": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "action": {
            "enum": [
              "unchanged",
              "migrated",
              "initialized",
              "imported",
              "blocked",
              "failed",
              "not_attempted"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "integration_api_version",
                  "code",
                  "message",
                  "recovery",
                  "exit_code"
                ],
                "properties": {
                  "integration_api_version": {
                    "const": 1
                  },
                  "code": {
                    "enum": [
                      "invalid_arguments",
                      "unsupported_api_version",
                      "store_selection_failed",
                      "operation_failed",
                      "unsupported_schema",
                      "migration_failed",
                      "backup_failed",
                      "schema_changed",
                      "idempotency_conflict"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "recovery": {
                    "type": "string"
                  },
                  "exit_code": {
                    "enum": [
                      1,
                      2,
                      12,
                      16,
                      17,
                      18
                    ]
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "skipped_registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
