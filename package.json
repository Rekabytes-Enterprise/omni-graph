{
  "name": "omni-graph",
  "version": "0.2.7",
  "description": "Shared memory and a Rust graph TUI for AI coding agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "omni-graph": "bin/omni-graph.mjs"
  },
  "files": [
    "bin",
    "native",
    "skills",
    "assets",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "contracts",
    "docs/integration-contract.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cargo build --release",
    "web:vendor": "node scripts/vendor-web.mjs",
    "test": "cargo test && node --test tests/launcher.test.mjs tests/install.test.mjs tests/version.test.mjs tests/web.test.mjs tests/compatibility.test.mjs tests/benchmark.test.mjs",
    "check": "node scripts/version.mjs check && cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "prepublishOnly": "node scripts/check-package.mjs",
    "version:bump": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs check",
    "benchmark:recall": "node scripts/benchmark-recall.mjs"
  },
  "keywords": [
    "agents",
    "memory",
    "graph",
    "codex",
    "claude",
    "pi",
    "tui"
  ],
  "homepage": "https://github.com/Rekabytes-Enterprise/omni-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rekabytes-Enterprise/omni-graph.git"
  },
  "bugs": {
    "url": "https://github.com/Rekabytes-Enterprise/omni-graph/issues"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "three": "0.186.1"
  }
}
